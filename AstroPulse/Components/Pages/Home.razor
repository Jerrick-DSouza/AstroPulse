@code {
    [Inject] private TelemetryEngine Engine { get; set; } = default!;
    private AstroHealthSnapshot _snapshot = new();

    protected override void OnInitialized()
    {
        _snapshot = Engine.CurrentSnapshot;
        Engine.OnTelemetryUpdated += OnTelemetryTick;
        Engine.Start();
    }

    private void OnTelemetryTick(AstroHealthSnapshot updatedSnapshot)
    {
        InvokeAsync(() =>
        {
            _snapshot = updatedSnapshot;
            StateHasChanged();
        });
    }

    private void TriggerSpe()
    {
        Engine.SetSolarParticleEvent(!_snapshot.SpaceRadiation.SolarParticleEventActive);
    }

    private void CycleGravity()
    {
        var nextMode = _snapshot.GravityFields.CurrentGravityMode switch
        {
            GravityMode.ZeroG => GravityMode.MarsOneThirdG,
            GravityMode.MarsOneThirdG => GravityMode.EarthOneG,
            GravityMode.EarthOneG => GravityMode.ZeroG,
            _ => GravityMode.ZeroG
        };
        Engine.SetGravityMode(nextMode);
    }

    private void ToggleLight()
    {
        Engine.ToggleLightTherapy();
    }

    private async Task ExportMissionLog()
    {
        var exportPackage = new
        {
            Mission = "NASA Space Apps Challenge - AstroPulse",
            ExportTimestampUtc = DateTime.UtcNow,
            TotalRecords = Engine.SnapshotHistory.Count,
            HistoricalTelemetry = Engine.SnapshotHistory,
            ComplianceStandards = new[] { "NASA-STD-3001 Vol 1 & 2", "NASA HRP Physiological Hazards", "CSA CANS Neutron Spectrometer" }
        };

        var json = JsonSerializer.Serialize(exportPackage, new JsonSerializerOptions { WriteIndented = true });
        var base64Bytes = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        var fileName = $"AstroPulse_FullMissionLog_{DateTime.UtcNow:yyyyMMdd_HHmmss}.json";

        await JS.InvokeVoidAsync("eval", $@"
            const bs = '{base64Bytes}';
            const bin = atob(bs);
            const buf = new Uint8Array(bin.length);
            for (let i = 0; i < bin.length; i++) {{ buf[i] = bin.charCodeAt(i); }}
            const blob = new Blob([buf], {{ type: 'application/json' }});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        ");
    }

    private string GetAlertCardClass(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => "border-red-400/20 bg-red-400/[.035] text-red-200",
        AlertSeverity.Warning => "border-amber-400/15 bg-amber-400/[.025] text-amber-200",
        _ => "border-emerald-400/15 bg-emerald-400/[.025] text-emerald-200"
    };

    private string GetSeverityDotClass(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => "bg-red-400 shadow-[0_0_10px_#fb7185]",
        AlertSeverity.Warning => "bg-amber-400 shadow-[0_0_10px_#fbbf24]",
        _ => "bg-emerald-400 shadow-[0_0_10px_#34d399]"
    };

    public void Dispose()
    {
        Engine.OnTelemetryUpdated -= OnTelemetryTick;
    }
}
