                        <button type="submit"
                                class="flex min-h-10 items-center justify-center gap-2 rounded-lg border border-cyan-300/25 bg-cyan-300/[.08] px-4 text-[10px] font-semibold tracking-[.12em] text-cyan-100 transition-colors hover:bg-cyan-300/[.14] sm:col-span-2">
