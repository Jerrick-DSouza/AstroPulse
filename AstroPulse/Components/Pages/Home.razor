@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>AstroPulse | Human Spaceflight Monitor</PageTitle>

<audio id="alertSound" preload="auto" loop>
    <source src="audio/alert.mp3" type="audio/mpeg" />
</audio>

<main class="min-h-screen bg-[#070b11] text-slate-300 selection:bg-cyan-400/20">
    <!-- PERSISTENT HEADER -->
    <header class="sticky top-0 z-30 border-b border-white/[.08] bg-[#080d14]/95 shadow-[0_8px_28px_rgba(0,0,0,.2)] backdrop-blur-xl">
        <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-x-5 gap-y-3 px-4 py-3 sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
                <div class="relative flex size-10 shrink-0 items-center justify-center rounded-xl border border-cyan-400/20 bg-cyan-400/[.06] text-cyan-300 overflow-hidden">
                    <img src="images/logo.png" alt="Logo" class="size-8 object-contain" />
                </div>
                <div>
                    <div class="flex flex-wrap items-baseline gap-2">
                        <h1 class="font-mono text-lg font-semibold tracking-[.14em] text-white">ASTROPULSE</h1>
                        <span class="hidden text-[9px] tracking-[.14em] text-slate-600 sm:block">HUMAN SPACEFLIGHT MONITOR</span>
                    </div>
                    <p class="text-[9px] tracking-[.12em] text-slate-500">MISSION CONTROL <span class="text-slate-700">/</span> ARTEMIS DEEP SPACE SIM</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                <div class="rounded-lg border border-white/[.08] bg-white/[.02] px-2.5 py-1.5">
                    <span class="block text-[7px] tracking-[.12em] text-slate-600">MISSION ELAPSED</span>
                    <span class="font-mono text-[10px] text-slate-200">@MissionElapsed</span>
                </div>

                <label class="flex flex-col gap-0.5">
                    <span class="text-[7px] tracking-[.12em] text-slate-600">ENVIRONMENT</span>
                    <select aria-label="Mission environment" value="@SelectedEnvironment" @onchange="OnEnvironmentChanged"
                            class="max-w-[130px] rounded-md border border-white/10 bg-[#0b121b] px-2 py-1.5 text-[8px] tracking-[.08em] text-cyan-100 outline-none focus:border-cyan-300/40">
                        @foreach (var opt in EnvironmentOptions)
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    </select>
                </label>

                <div class="flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 @(IsOffline ? "border-amber-400/20 bg-amber-400/[.05]" : "border-cyan-400/15 bg-cyan-400/[.035]")">
                    <span class="text-xs @(IsOffline ? "text-amber-300" : "text-cyan-300")">📡</span>
                    <div>
                        <span class="block text-[7px] tracking-[.1em] text-slate-600">EARTH LATENCY</span>
                        <span class="font-mono text-[10px] @(IsOffline ? "text-amber-200" : "text-cyan-100")">
                            @(LatencySeconds / 60)m @((LatencySeconds % 60).ToString("D2"))s
                        </span>
                    </div>
                </div>

                <div role="status" class="flex items-center gap-1.5 rounded-lg border px-2.5 py-2 @GetToneBorder(MasterTone) @GetToneBadge(MasterTone)">
                    <span class="size-2 shrink-0 rounded-full @GetToneFill(MasterTone) @GetToneGlow(MasterTone) @(MasterTone == "red" ? "animate-pulse" : "")"></span>
                    <span class="text-[8px] font-semibold tracking-[.08em]">
                        @(MasterTone == "red" ? "CRITICAL" : MasterTone == "amber" ? "CAUTION" : "NOMINAL")
                    </span>
                </div>

                <time class="hidden items-center gap-1.5 font-mono text-[9px] text-slate-500 xl:flex">
                    <span>🕒</span>@(UtcTime)Z
                </time>
            </div>
        </div>

        <!-- TAB NAVIGATION -->
        <nav aria-label="Mission views" class="mx-auto grid max-w-[1600px] grid-cols-4 gap-0 px-2 sm:flex sm:gap-1 sm:overflow-x-auto sm:px-6 lg:px-8">
            @foreach (var tab in Tabs)
            {
                var isActive = ActiveTab == tab.Id;
                <button type="button" @onclick="() => ActiveTab = tab.Id"
                        class="relative flex min-w-0 items-center justify-center gap-1.5 border-b-2 px-1 py-3 text-[7px] font-semibold tracking-[.04em] transition-colors sm:flex-none sm:shrink-0 sm:gap-2 sm:px-3 sm:text-[9px] sm:tracking-[.08em] @(isActive ? "border-cyan-300 text-cyan-100" : "border-transparent text-slate-500 hover:text-slate-200")">
                    <span>@tab.Icon</span>
                    <span class="hidden sm:inline">@tab.Label</span>
                    <span class="sm:hidden">@tab.ShortLabel</span>
                </button>
            }
        </nav>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <div class="mx-auto max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">
        <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
            <div>
                <div class="mb-2 flex items-center gap-2 text-[9px] tracking-[.2em] text-cyan-400">
                    <span class="h-px w-5 bg-cyan-400"></span>FLIGHT DECK <span class="text-slate-700">/</span> FLIGHT DAY 184 <span class="text-slate-700">/</span> CREW 02
                </div>
                <h2 class="text-2xl font-medium tracking-tight text-white sm:text-3xl">
                    @Tabs.First(t => t.Id == ActiveTab).Label
                </h2>
                <p class="mt-1.5 text-xs text-slate-500">Human systems monitoring · Artemis deep space transit simulation</p>
            </div>
            <div class="flex items-center gap-2 rounded-lg border border-white/[.08] bg-white/[.02] px-3 py-2 text-[9px] tracking-[.1em] text-slate-500">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-40"></span>
                    <span class="relative size-2 rounded-full bg-emerald-400"></span>
                </span>
                SIMULATED TELEMETRY <span class="font-mono text-emerald-300">LIVE</span>
            </div>
        </div>

        <!-- TAB 1: COMMAND & BODY MAP -->
        @if (ActiveTab == "command")
        {
            <div class="flex flex-col gap-4">
                <div class="grid gap-4 lg:grid-cols-2">
                    <!-- INTERACTIVE BODY MAP -->
                    <section class="rounded-xl border border-white/[.08] bg-[#0b121b] p-4 sm:p-5">
                        <div class="mb-4 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2.5">
                                <span class="flex size-8 items-center justify-center rounded-lg border border-cyan-400/15 bg-cyan-400/[.04] text-cyan-300">🧬</span>
                                <div>
                                    <p class="text-[8px] tracking-[.14em] text-slate-600">HRP HUMAN SYSTEMS · CREW 02</p>
                                    <h2 class="text-[11px] font-semibold tracking-[.1em] text-slate-100">Interactive body map</h2>
                                </div>
                            </div>
                            <span class="rounded-full bg-emerald-400/10 px-2 py-1 text-[8px] text-emerald-300">CREW 02</span>
                        </div>

                        <!-- ANATOMY CANVAS -->
                        <div class="relative mx-auto h-[300px] max-w-[480px] overflow-hidden rounded-lg border border-white/[.05] bg-[radial-gradient(ellipse_at_50%_48%,rgba(34,211,238,.08),transparent_60%)]">
                            <div aria-hidden="true" class="absolute inset-0 opacity-40"
                                 style="background-image: linear-gradient(rgba(148,163,184,.07) 1px, transparent 1px),linear-gradient(90deg,rgba(148,163,184,.07) 1px,transparent 1px); background-size: 24px 24px;"></div>
                            <div aria-hidden="true" class="absolute left-1/2 top-1/2 h-[246px] w-[120px] -translate-x-1/2 -translate-y-1/2">
                                <div class="absolute left-1/2 top-1 h-[44px] w-[42px] -translate-x-1/2 rounded-[48%] border border-cyan-300/30 bg-cyan-400/[.07]"></div>
                                <div class="absolute left-1/2 top-[51px] h-[79px] w-[70px] -translate-x-1/2 rounded-[38%_38%_26%_26%] border border-cyan-300/25 bg-cyan-400/[.06]"></div>
                                <div class="absolute left-[2px] top-[58px] h-[106px] w-[22px] -rotate-[12deg] rounded-full border border-cyan-300/20 bg-cyan-400/[.04]"></div>
                                <div class="absolute right-[2px] top-[58px] h-[106px] w-[22px] rotate-[12deg] rounded-full border border-cyan-300/20 bg-cyan-400/[.04]"></div>
                                <div class="absolute left-[27px] top-[121px] h-[111px] w-[25px] -rotate-[4deg] rounded-b-xl rounded-t-md border border-cyan-300/20 bg-cyan-400/[.04]"></div>
                                <div class="absolute right-[27px] top-[121px] h-[111px] w-[25px] rotate-[4deg] rounded-b-xl rounded-t-md border border-cyan-300/20 bg-cyan-400/[.04]"></div>
                                <div class="absolute left-[43px] top-[67px] size-3 rounded-full border border-rose-300/60 bg-rose-400/25 shadow-[0_0_12px_rgba(251,113,133,.5)]"></div>
                                <div class="absolute left-[47px] top-[92px] h-7 w-6 rounded-full border border-amber-300/50 bg-amber-400/15"></div>
                                <div class="absolute left-[48px] top-[31px] size-2 rounded-full bg-cyan-300/70 shadow-[0_0_10px_#67e8f9]"></div>
                            </div>

                            @foreach (var reg in MapButtons)
                            {
                                var isSel = SelectedRegion == reg.Name;
                                <button type="button" @onclick="() => SelectedRegion = reg.Name"
                                        class="absolute @reg.Position z-10 flex items-center gap-1.5 rounded-full border px-2.5 py-1.5 text-[8px] tracking-[.08em] transition-colors @(isSel ? "border-cyan-300/45 bg-cyan-300/15 text-cyan-100" : "border-white/10 bg-[#080d14]/90 text-slate-400 hover:border-cyan-300/30 hover:text-cyan-100")">
                                    <span>@reg.Icon</span>@reg.Short
                                </button>
                            }

                            <div class="absolute bottom-3 left-3 flex items-center gap-2 text-[8px] tracking-[.12em] text-slate-600">
                                <span class="size-1.5 rounded-full bg-cyan-300 shadow-[0_0_7px_#67e8f9]"></span>REGION SELECT · SIMULATED
                            </div>
                        </div>

                        @{
                            var currentRegion = RegionDetails[SelectedRegion];
                        }
                        <div class="mt-3 rounded-lg border @GetToneBorder(currentRegion.Status) bg-white/[.02] p-3">
                            <div class="flex items-start gap-3">
                                <span class="flex size-8 shrink-0 items-center justify-center rounded-lg @GetToneBadge(currentRegion.Status)">
                                    @currentRegion.Icon
                                </span>
                                <div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="text-xs font-medium text-white">@SelectedRegion</h3>
                                        <span class="flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[8px] @GetToneBadge(currentRegion.Status)">
                                            <span class="size-1.5 rounded-full @GetToneFill(currentRegion.Status)"></span>
                                            @currentRegion.Status.ToUpper()
                                        </span>
                                    </div>
                                    <p class="mt-1 text-[10px] text-slate-400">@currentRegion.Summary</p>
                                </div>
                            </div>
                            <div class="mt-3 grid gap-3 border-t border-white/[.06] pt-3 sm:grid-cols-2">
                                <div>
                                    <p class="text-[8px] tracking-[.12em] text-slate-600">SPACEFLIGHT IMPACT</p>
                                    <p class="mt-1 text-[9px] leading-relaxed text-slate-400">@currentRegion.Impact</p>
                                </div>
                                <div>
                                    <p class="text-[8px] tracking-[.12em] text-slate-600">COUNTERMEASURE</p>
                                    <p class="mt-1 text-[9px] leading-relaxed text-slate-400">@currentRegion.Action</p>
                                </div>
                            </div>
                        </div>
                        <p class="mt-2 flex items-center gap-1.5 text-[8px] text-slate-600">ⓘ Simulated physiology context; not a clinical diagnosis.</p>
                    </section>

                    <!-- ASTROAI EDGE ADVISOR -->
                    <section class="rounded-xl border border-white/[.08] bg-[#0b121b] p-4 sm:p-5">
                        <div class="mb-4 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2.5">
                                <span class="flex size-8 items-center justify-center rounded-lg border border-cyan-400/15 bg-cyan-400/[.04] text-cyan-300">📡</span>
                                <div>
                                    <p class="text-[8px] tracking-[.14em] text-slate-600">EARTH LINK · DELAY AWARE</p>
                                    <h2 class="text-[11px] font-semibold tracking-[.1em] text-slate-100">AstroAI edge advisor</h2>
                                </div>
                            </div>
                            <span class="flex items-center gap-1.5 rounded-full px-2 py-1 text-[8px] @(IsOffline ? GetToneBadge("amber") : GetToneBadge("green"))">
                                <span class="size-1.5 rounded-full @(IsOffline ? GetToneFill("amber") : GetToneFill("green"))"></span>
                                @(IsOffline ? "EDGE ACTIVE" : "LINKED")
                            </span>
                        </div>

                        <div class="rounded-lg border p-3 @(IsOffline ? "border-amber-400/20 bg-amber-400/[.04]" : "border-emerald-400/15 bg-emerald-400/[.025]")">
                            <p class="text-[10px] font-semibold tracking-[.06em] @(IsOffline ? "text-amber-200" : "text-emerald-200")">
                                @(IsOffline ? "OFFLINE: AUTONOMOUS EDGE OVERRIDE ACTIVE" : "LINKED · EARTH MISSION CONTROL")
                            </p>
                            <p class="mt-1 text-[9px] text-slate-500">
                                @(IsOffline ? "One-way comms delay exceeds the 20-minute autonomy threshold." : "Earth link nominal · autonomous crew procedures remain on standby.")
                            </p>
                        </div>

                        <div class="mt-3 flex items-start gap-2.5">
                            <span class="flex size-7 shrink-0 items-center justify-center rounded-lg border border-cyan-300/15 bg-cyan-300/[.06] text-cyan-300">✨</span>
                            <div>
                                <p class="text-[10px] font-medium text-slate-200">@(IsOffline ? "Local remediation directives" : "Crew decision support")</p>
                                <ul class="mt-2 flex flex-col gap-2 text-[9px] leading-relaxed text-slate-400">
                                    <li class="flex gap-2">
                                        <span class="font-mono text-cyan-400">01</span>
                                        @(IsOffline ? "Execute onboard radiation shelter checklist; verify dosimeter trend locally." : "Review the active radiation alert and confirm crew shelter readiness.")
                                    </li>
                                    <li class="flex gap-2">
                                        <span class="font-mono text-cyan-400">02</span>
                                        @(IsOffline ? "Continue prescribed resistance protocol; record symptoms in the daily health log." : "Flight surgeon remains available for non-urgent consultation while linked.")
                                    </li>
                                    <li class="flex gap-2">
                                        <span class="font-mono text-cyan-400">03</span>
                                        @(IsOffline ? "Queue non-urgent telemetry for transmission when Earth link recovers." : "Autonomous guidance threshold: 1,200 seconds one-way delay.")
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <button type="button" @onclick="ToggleLatency"
                                class="mt-4 flex min-h-9 w-full items-center justify-center gap-2 rounded-lg border border-white/[.08] bg-[#080d14] px-3 text-[9px] tracking-[.08em] text-slate-300 hover:border-cyan-300/25 hover:text-cyan-100">
                            @(IsOffline ? "RESTORE SIMULATED EARTH LINK" : "SIMULATE >20 MIN LATENCY")
                        </button>
                        <p class="mt-2 text-center text-[8px] text-slate-700">Rule-based demo only · not a medical device or validated AI system.</p>
                    </section>
                </div>

                <!-- MISSION ALERTS -->
                <section class="rounded-xl border border-white/[.08] bg-[#0b121b] p-4">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5">
                            <span class="flex size-8 items-center justify-center rounded-lg border border-cyan-400/15 bg-cyan-400/[.04] text-cyan-300">⚠️</span>
                            <div>
                                <p class="text-[8px] tracking-[.14em] text-slate-600">REAL-TIME · LOCAL SIMULATION</p>
                                <h2 class="text-[11px] font-semibold tracking-[.1em] text-slate-100">Mission alerts</h2>
                            </div>
                        </div>
                        <span class="rounded-full px-2 py-1 font-mono text-[8px] @GetToneBadge(MasterTone)">@ActiveAlertCount.ToString("D2") OPEN</span>
                    </div>

                    <div class="grid gap-2.5 md:grid-cols-3">
                        @foreach (var alert in Alerts.Take(3))
                        {
                            <article class="rounded-lg border p-3 @GetToneBorder(alert.Tone) @(alert.Tone == "red" ? "bg-rose-400/[.025]" : alert.Tone == "amber" ? "bg-amber-400/[.025]" : "bg-emerald-400/[.025]")">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="flex items-center gap-2 text-[8px] tracking-[.12em] text-slate-300">
                                        <span class="size-2 rounded-full @GetToneFill(alert.Tone)"></span>
                                        @(alert.Tone == "red" ? "CRITICAL" : alert.Tone == "amber" ? "CAUTION" : "CLEARED")
                                    </span>
                                    <time class="font-mono text-[8px] text-slate-600">@(alert.Time)Z</time>
                                </div>
                                <h3 class="text-[10px] font-medium text-slate-200">@alert.Title</h3>
                                <p class="mt-1 text-[9px] leading-relaxed text-slate-500">@alert.Body</p>
                                <div class="mt-2 flex items-center gap-1 rounded px-2 py-1.5 text-[8px] @GetToneBadge(alert.Tone)">
                                    <span>›</span>@alert.Action
                                </div>
                            </article>
                        }
                    </div>
                </section>

                <audio id="alertSound" preload="auto">
                    <source src="audio/alert.mp3" type="audio/mpeg" />
                </audio>

                <!-- NASA HRP FIVE HAZARDS -->
                <section class="rounded-xl border border-white/[.08] bg-[#0b121b] p-4">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="flex size-8 items-center justify-center rounded-lg border border-cyan-400/15 bg-cyan-400/[.04] text-cyan-300">🛡️</span>
                        <div>
                            <p class="text-[8px] tracking-[.14em] text-slate-600">NASA HRP · FIVE HAZARDS</p>
                            <h2 class="text-[11px] font-semibold tracking-[.1em] text-slate-100">Risk watch</h2>
                        </div>
                    </div>
                    <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-5">
                        <div class="rounded-lg border border-white/[.06] bg-[#080d14] p-3">
                            <p class="text-[8px] tracking-[.12em] text-slate-600">SPACE RADIATION</p>
                            <p class="mt-1 text-xs font-medium text-white">@(SolarEvent ? "SPE Warning Flux" : "CSA CANS Flux Active")</p>
                            <p class="mt-1 text-[9px] text-slate-500">@(SolarEvent ? "Storm cellar protocol active" : "Shielding posture nominal")</p>
                        </div>
                        <div class="rounded-lg border border-white/[.06] bg-[#080d14] p-3">
                            <p class="text-[8px] tracking-[.12em] text-slate-600">ISOLATION</p>
                            <p class="mt-1 text-xs font-medium text-white">Day 184 In Transit</p>
                            <p class="mt-1 text-[9px] text-slate-500">Circadian rhythms steady</p>
                        </div>
                        <div class="rounded-lg border border-white/[.06] bg-[#080d14] p-3">
                            <p class="text-[8px] tracking-[.12em] text-slate-600">DISTANCE / LATENCY</p>
                            <p class="mt-1 text-xs font-medium text-white">@(LatencySeconds / 60) min @(LatencySeconds % 60) sec</p>
                            <p class="mt-1 text-[9px] text-slate-500">@(IsOffline ? "Autonomous edge active" : "Comms link nominal")</p>
                        </div>
                        <div class="rounded-lg border border-white/[.06] bg-[#080d14] p-3">
                            <p class="text-[8px] tracking-[.12em] text-slate-600">GRAVITY FIELDS</p>
                            <p class="mt-1 text-xs font-medium text-white">@(MicrogravityShift ? "Microgravity Override" : "Deep Space Transit")</p>
                            <p class="mt-1 text-[9px] text-slate-500">Countermeasures active</p>
                        </div>
                        <div class="rounded-lg border border-white/[.06] bg-[#080d14] p-3">
                            <p class="text-[8px] tracking-[.12em] text-slate-600">CLOSED ENVIRONMENT</p>
                            <p class="mt-1 text-xs font-medium text-white">ECLSS Nominal</p>
                            <p class="mt-1 text-[9px] text-slate-500">Acoustics and air balanced</p>
                        </div>
                    </div>
                </section>
            </div>
        }

        <!-- TAB 2: CREW VITALS & CHECK-IN -->
        @if (ActiveTab == "vitals")
        {
            <div class="grid items-start gap-4 lg:grid-cols-[1fr_380px]">
                <section class="rounded-xl border border-white/[.08] bg-[#0b121b] p-4 sm:p-5">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="flex size-8 items-center justify-center rounded-lg border border-cyan-400/15 bg-cyan-400/[.04] text-cyan-300">❤️</span>
                        <div>
                            <p class="text-[8px] tracking-[.14em] text-slate-600">CREW 02 · DAILY ENTRY</p>
                            <h2 class="text-[11px] font-semibold tracking-[.1em] text-slate-100">Manual health indicator logging</h2>
                        </div>
                    </div>

                    <EditForm Model="@CurrentEntry" OnValidSubmit="SaveHealthLog" class="grid gap-x-4 gap-y-4 sm:grid-cols-2">
                        <label class="flex flex-col gap-1.5">
                            <span class="flex items-center justify-between text-[10px] text-slate-300">Blood pressure *<span class="text-[9px] text-slate-600">mmHg · SYS / DIA</span></span>
                            <InputText @bind-Value="CurrentEntry.BloodPressure" required placeholder="118/76"
                                       class="h-10 rounded-lg border border-white/10 bg-[#080d14] px-3 font-mono text-xs text-white outline-none placeholder:text-slate-700 focus:border-cyan-300/40" />
                        </label>

                        <label class="flex flex-col gap-1.5">
                            <span class="flex items-center justify-between text-[10px] text-slate-300">Heart rate *<span class="text-[9px] text-slate-600">BPM</span></span>
                            <InputText @bind-Value="CurrentEntry.HeartRate" required type="number" min="30" max="220" placeholder="64"
                                       class="h-10 rounded-lg border border-white/10 bg-[#080d14] px-3 font-mono text-xs text-white outline-none placeholder:text-slate-700 focus:border-cyan-300/40" />
                        </label>

                        <label class="flex flex-col gap-1.5">
                            <span class="flex items-center justify-between text-[10px] text-slate-300">Blood glucose<span class="text-[9px] text-slate-600">mg/dL</span></span>
                            <InputText @bind-Value="CurrentEntry.BloodSugar" type="number" step="0.1" placeholder="92"
                                       class="h-10 rounded-lg border border-white/10 bg-[#080d14] px-3 font-mono text-xs text-white outline-none placeholder:text-slate-700 focus:border-cyan-300/40" />
                        </label>

                        <label class="flex flex-col gap-1.5">
                            <span class="flex items-center justify-between text-[10px] text-slate-300">Body temperature<span class="text-[9px] text-slate-600">°C</span></span>
                            <InputText @bind-Value="CurrentEntry.Temperature" type="number" step="0.1" placeholder="36.7"
                                       class="h-10 rounded-lg border border-white/10 bg-[#080d14] px-3 font-mono text-xs text-white outline-none placeholder:text-slate-700 focus:border-cyan-300/40" />
                        </label>

                        <label class="flex flex-col gap-1.5">
