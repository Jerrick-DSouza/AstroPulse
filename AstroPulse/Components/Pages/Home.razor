                    </section>
                </div>
            </div>
        }

        <!-- TAB 3: TELEMETRY & TRENDS -->
        @if (ActiveTab == "telemetry")
        {
            <section class="rounded-xl border border-white/[.08] bg-[#0b121b] p-4 sm:p-5">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                        <span class="flex size-8 items-center justify-center rounded-lg border border-cyan-400/15 bg-cyan-400/[.04] text-cyan-300">📈</span>
                        <div>
                            <p class="text-[8px] tracking-[.14em] text-slate-600">REAL-TIME TELEMETRY STREAM</p>
                            <h2 class="text-[11px] font-semibold tracking-[.1em] text-slate-100">Habitat metrics &amp; radiation flux</h2>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <button type="button" @onclick="ToggleSolarEvent"
                                class="rounded-lg border px-3 py-1.5 text-[9px] tracking-[.08em] @(SolarEvent ? "border-rose-400/40 bg-rose-400/20 text-rose-200 shadow-[0_0_10px_rgba(251,113,133,.25)]" : "border-white/10 bg-[#080d14] text-slate-300 hover:border-cyan-300/30")">
                            ☢️ @(SolarEvent ? "SOLAR EVENT SIM ACTIVE" : "TRIGGER SOLAR PARTICLE EVENT")
                        </button>
                        <button type="button" @onclick="ToggleMicrogravity"
                                class="rounded-lg border px-3 py-1.5 text-[9px] tracking-[.08em] @(MicrogravityShift ? "border-amber-400/40 bg-amber-400/20 text-amber-200" : "border-white/10 bg-[#080d14] text-slate-300 hover:border-cyan-300/30")">
                            🌀 @(MicrogravityShift ? "MICROGRAVITY PROFILE" : "SIMULATE GRAVITY SHIFT")
                        </button>
                    </div>
                </div>

                <!-- 4 DYNAMIC HIGH-PRECISION SPARKLINE CHARTS MATCHING REFERENCE -->
                <div class="grid gap-3 sm:grid-cols-2">
                    @RenderChartCard("CABIN PRESSURE", "kPa", "#34d399", 98, 104, s => s.Pressure, "F1", SolarEvent ? "amber" : "green")
                    @RenderChartCard("CABIN TEMPERATURE", "°C", "#22d3ee", 19, 25, s => s.Temperature, "F2", "cyan")
                    @RenderChartCard("ACOUSTIC LEVEL", "dBA", "#fbbf24", 40, 70, s => s.Acoustics, "F2", MicrogravityShift ? "amber" : "amber")
                    @RenderChartCard("CSA CANS NEUTRON FLUX", "n/cm²/s", "#fb7185", 0, 50.0, s => s.Radiation, "F1", SolarEvent ? "red" : "rose")
                </div>
            </section>
        }

        <!-- TAB 4: FLIGHT SURGEON LOGS -->
        @if (ActiveTab == "logs")
        {
            <section class="rounded-xl border border-white/[.08] bg-[#0b121b] p-4 sm:p-5">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                        <span class="flex size-8 items-center justify-center rounded-lg border border-cyan-400/15 bg-cyan-400/[.04] text-cyan-300">📋</span>
                        <div>
                            <p class="text-[8px] tracking-[.14em] text-slate-600">MISSION RECORDS</p>
                            <h2 class="text-[11px] font-semibold tracking-[.1em] text-slate-100">Flight surgeon diagnostic history</h2>
                        </div>
                    </div>

                    <button type="button" @onclick="ExportLogsJson" disabled="@(Logs.Count == 0)"
                            class="flex min-h-9 items-center gap-2 rounded-lg border border-cyan-300/25 bg-cyan-300/[.08] px-3.5 text-[9px] tracking-[.08em] text-cyan-100 hover:bg-cyan-300/[.14] disabled:opacity-40">
                        ⬇ EXPORT MISSION LOG (JSON)
                    </button>
                </div>

                @if (Logs.Count == 0)
                {
                    <div class="rounded-lg border border-dashed border-white/10 p-8 text-center">
                        <p class="text-xs text-slate-500">No health logs submitted in this session yet.</p>
                        <p class="mt-1 text-[9px] text-slate-600">Navigate to "Crew Vitals &amp; Check-In" to record the day’s indicators.</p>
                    </div>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var log in Logs)
                        {
                            <div class="rounded-lg border border-white/[.08] bg-[#080d14] p-4">
                                <div class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-white/[.06] pb-2">
                                    <span class="font-mono text-[9px] text-cyan-400">@log.Timestamp</span>
                                    <span class="rounded bg-white/[.05] px-2 py-0.5 text-[8px] text-slate-300">
                                        Mood: @(string.IsNullOrWhiteSpace(log.Mood) ? "Not specified" : log.Mood)
                                    </span>
                                </div>
                                <div class="grid gap-2 text-[10px] sm:grid-cols-3 md:grid-cols-6">
                                    <p><span class="block text-[8px] text-slate-600">BP</span><span class="font-mono text-white">@log.BloodPressure mmHg</span></p>
                                    <p><span class="block text-[8px] text-slate-600">HR</span><span class="font-mono text-white">@log.HeartRate BPM</span></p>
                                    <p><span class="block text-[8px] text-slate-600">GLUCOSE</span><span class="font-mono text-white">@(string.IsNullOrWhiteSpace(log.BloodSugar) ? "—" : $"{log.BloodSugar} mg/dL")</span></p>
                                    <p><span class="block text-[8px] text-slate-600">TEMP</span><span class="font-mono text-white">@(string.IsNullOrWhiteSpace(log.Temperature) ? "—" : $"{log.Temperature} °C")</span></p>
                                    <p><span class="block text-[8px] text-slate-600">SLEEP</span><span class="font-mono text-white">@(string.IsNullOrWhiteSpace(log.Sleep) ? "—" : $"{log.Sleep} hrs")</span></p>
                                    <p><span class="block text-[8px] text-slate-600">ACTIVITY</span><span class="font-mono text-white">@(string.IsNullOrWhiteSpace(log.Actigraphy) ? "—" : log.Actigraphy)</span></p>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(log.Notes))
                                {
                                    <p class="mt-3 border-t border-white/[.04] pt-2 text-[9px] text-slate-400">Notes: @log.Notes</p>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }

        <!-- TOAST NOTIFICATION -->
        @if (SavedNotice)
        {
            <div role="status" aria-live="polite"
                 class="fixed bottom-6 right-6 z-50 flex items-center gap-2 rounded-xl border border-emerald-400/30 bg-[#0b121b] px-4 py-3 text-xs text-emerald-200 shadow-2xl backdrop-blur-xl">
                <span class="text-emerald-400">✓</span> Daily check-in saved successfully in session.
            </div>
        }
    </div>
</main>

@code {
    // --- STATE ---
    private string UtcTime = DateTime.UtcNow.ToString("HH:mm:ss");
    private int ElapsedSeconds = 184 * 86400 + 6 * 3600;
    private string SelectedEnvironment = "spacecraft";
    private string ActiveTab = "command";
    private bool SolarEvent = false;
    private bool MicrogravityShift = false;
    private int LatencySeconds = 751;
    private string SelectedRegion = "Musculoskeletal";
    private bool SavedNotice = false;

    private HealthLogEntry CurrentEntry = new();
    private List<HealthLogEntry> Logs = new();
    private List<MissionAlert> Alerts = new();
    private List<TelemetrySample> Samples = new();

    private PeriodicTimer? _secondTimer;
    private CancellationTokenSource _cts = new();
    private readonly Random _rng = new();
    private int _tickCounter = 0;

    private bool SolarEventActive = false;
    private bool GravityShiftActive = false;
    private bool LatencyShiftActive = false;

    private int CriticalCount => SolarEventActive ? 1 : 0;
    private int CautionCount => (GravityShiftActive ? 1 : 0) + (LatencyShiftActive ? 1 : 0);
    private int TotalOpenAlerts => CriticalCount + CautionCount;

    // --- COMPUTED PROPERTIES ---
    private bool IsOffline => LatencySeconds >= 1200;
    private int ActiveAlertCount => Alerts.Count(a => a.Tone != "green");
    private string MasterTone => Alerts.Any(a => a.Tone == "red") ? "red" : Alerts.Any(a => a.Tone == "amber") ? "amber" : "green";
    private string MissionElapsed => $"{ElapsedSeconds / 86400}d {(ElapsedSeconds % 86400) / 3600:D2}h {(ElapsedSeconds % 3600) / 60:D2}m";

    private record EnvOption(string Value, string Label, int Latency);
    private readonly List<EnvOption> EnvironmentOptions = new()
    {
        new("spacecraft", "SPACECRAFT", 751),
        new("gateway", "LUNAR GATEWAY", 2),
        new("mars-transit", "MARS TRANSIT", 1260),
        new("surface-base", "SURFACE BASE", 1260)
    };

    private record TabItem(string Id, string Label, string ShortLabel, string Icon);
    private readonly List<TabItem> Tabs = new()
    {
        new("command", "Command & Body Map", "COMMAND", "◎"),
        new("vitals", "Crew Vitals & Check-In", "CREW VITALS", "❤️"),
        new("telemetry", "Telemetry & Trends", "TELEMETRY", "📈"),
        new("logs", "Flight Surgeon Logs", "SURGEON LOGS", "🛡️")
    };

    private record MapButton(string Name, string Short, string Position, string Icon);
    private readonly List<MapButton> MapButtons = new()
    {
        new("Cardiovascular", "CARDIO", "left-[18%] top-[25%]", "❤️"),
        new("Musculoskeletal", "BONE", "right-[15%] top-[47%]", "🦴"),
        new("Ocular / vision", "VISION", "left-[11%] top-[9%]", "👁️"),
        new("CNS / behavioral", "CNS", "right-[13%] top-[19%]", "🧠")
    };

    private record RegionDetail(string Icon, string Status, string Summary, string Impact, string Action);
    private readonly Dictionary<string, RegionDetail> RegionDetails = new()
    {
        ["Cardiovascular"] = new("❤️", "green", "Cardiac rhythm and circulation stable.",
            "Microgravity redistributes fluids toward the thorax and head, altering cardiac preload and orthostatic tolerance.",
            "Continue prescribed aerobic conditioning; report dizziness or unusual exercise intolerance to the flight surgeon."),
        ["Musculoskeletal"] = new("🦴", "amber", "Bone density trend requires follow-up.",
            "Without weight-bearing load, lower-limb bone resorption may exceed formation during long-duration flight.",
            "Complete the prescribed resistance session and hydration plan; review the trend with the flight surgeon."),
        ["Ocular / vision"] = new("👁️", "amber", "Vision check-in due this mission week.",
            "Headward fluid shifts can contribute to ocular changes; radiation exposure may increase long-term cellular stress.",
            "Log vision changes and complete scheduled ocular checks; promptly report persistent symptoms."),
        ["CNS / behavioral"] = new("🧠", "green", "Mood and sleep indicators within crew baseline.",
            "Confinement, circadian disruption, and communication delay can affect sleep, attention, and team dynamics.",
            "Keep the sleep schedule, use the private check-in, and flag sustained mood or concentration changes.")
    };

    private async Task ControlAudio(bool play)
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
            var audio = document.getElementById('alertSound');
            if (audio) {
                if (" + (play ? "true" : "false") + @") {
                    audio.currentTime = 0;
                    audio.play();
                } else {
                    audio.pause();
                    audio.currentTime = 0;
                }
            }
        ");
        }
        catch
        {
        }
    }

    protected override void OnInitialized()
    {
        Alerts = new()
        {
            new("red", "14:32:08", "Radiation spike detected", "Neutron flux exceeded nominal threshold by 18%. Increase shielding posture.", "SHELTER IN STORM CELLAR"),
            new("amber", "14:28:41", "Bone mineral density trend", "Crew member 02: projected loss rate at 1.4% / month. Countermeasure window open.", "SCHEDULE RESISTANCE SESSION"),
            new("green", "14:21:16", "EVA suit pressure stable", "All pressure seals nominal. Suit telemetry synchronized with Houston.", "NO ACTION REQUIRED")
        };

        for (int i = 0; i < 60; i++)
        {
            Samples.Add(new TelemetrySample
            {
                Pressure = 101.2 + Math.Sin(i / 6.0) * 0.18,
                Temperature = 21.8 + Math.Cos(i / 8.0) * 0.12,
                Acoustics = 56.1 + Math.Sin(i / 3.0) * 1.5,
                Radiation = 0.53 + Math.Abs(Math.Sin(i / 4.0)) * 0.08
            });
        }

        _ = RunTelemetryLoopAsync();
    }

    private async Task RunTelemetryLoopAsync()
    {
        _secondTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await _secondTimer.WaitForNextTickAsync(_cts.Token))
            {
                UtcTime = DateTime.UtcNow.ToString("HH:mm:ss");
                ElapsedSeconds++;
                _tickCounter++;

                if (_tickCounter % 3 == 0) // Faster stream updates for organic graph motion
                {
                    if (Samples.Count >= 60) Samples.RemoveAt(0);
                    
                    double baseRad = SolarEvent ? 35.0 + (_rng.NextDouble() * 15.0) : 0.52 + (_rng.NextDouble() * 0.06);
                    double baseAcoustics = MicrogravityShift ? 62.4 + (_rng.NextDouble() - 0.5) * 3.0 : 56.0 + (_rng.NextDouble() - 0.5) * 1.8;

                    Samples.Add(new TelemetrySample
                    {
                        Pressure = 101.2 + Math.Sin(_tickCounter / 5.0) * 0.22 + (_rng.NextDouble() - 0.5) * 0.08,
                        Temperature = 21.81 + Math.Cos(_tickCounter / 7.0) * 0.15 + (_rng.NextDouble() - 0.5) * 0.05,
                        Acoustics = baseAcoustics,
                        Radiation = baseRad
                    });
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void AppendAlert(string title, string body, string tone, string action)
    {
        Alerts.Insert(0, new MissionAlert(tone, DateTime.UtcNow.ToString("HH:mm:ss"), title, body, action));
        if (Alerts.Count > 40) Alerts.RemoveAt(Alerts.Count - 1);
    }

    private void OnEnvironmentChanged(ChangeEventArgs e)
    {
        SelectedEnvironment = e.Value?.ToString() ?? "spacecraft";
        var opt = EnvironmentOptions.First(o => o.Value == SelectedEnvironment);
        LatencySeconds = opt.Latency;
        AppendAlert("Mission environment changed", $"Simulation environment set to {opt.Label}.", "amber", "REVIEW ENVIRONMENT PROFILE");
    }

    private bool LatencyActive = false; 

    private async Task ToggleLatency()
    {
        LatencyActive = !LatencyActive;
        var baseLat = EnvironmentOptions.First(o => o.Value == SelectedEnvironment).Latency;
    
        if (LatencyActive)
        {
            LatencySeconds = Math.Max(baseLat, 1260);
            AppendAlert("Earth link beyond autonomous threshold", "One-way delay exceeds 20 minutes. Local crew guidance is active.", "amber", "FOLLOW LOCAL ADVISORY");
            await ControlAudio(true);
        }
        else
        {
            LatencySeconds = baseLat;
            Alerts.RemoveAll(a => a.Title.Contains("Latency", StringComparison.OrdinalIgnoreCase) || a.Title.Contains("Earth link", StringComparison.OrdinalIgnoreCase));
            AppendAlert("Earth link restored to nominal delay", "One-way delay is below the 20-minute autonomy threshold.", "green", "EARTH LINK AVAILABLE");
            await ControlAudio(false);
        }
        StateHasChanged(); 
    }

    private async Task ToggleSolarEvent()
    {
        SolarEventActive = !SolarEventActive;
        SolarEvent = SolarEventActive;
    
        if (SolarEventActive)
        {
            AppendAlert("Radiation spike detected", "Neutron flux exceeded nominal threshold. Critical solar particle event active.", "red", "SHELTER IN STORM CELLAR");
            await ControlAudio(true);
        }
        else
        {
            Alerts.RemoveAll(a => a.Title.Contains("Radiation") || a.Title.Contains("solar", StringComparison.OrdinalIgnoreCase));
            AppendAlert("Solar particle event simulation reset", "Simulated neutron flux returned to baseline conditions.", "green", "MONITOR SENSOR TREND");
            await ControlAudio(false);
        }
        StateHasChanged();
    }

    private async Task ToggleMicrogravity()
    {
        GravityShiftActive = !GravityShiftActive;
        MicrogravityShift = GravityShiftActive;
    
        if (GravityShiftActive)
        {
            AppendAlert("Microgravity shift simulated", "Gravity simulation shifted to microgravity. Review balance and fluid-shift protocols.", "amber", "REVIEW CREW ADAPTATION");
            await ControlAudio(true);
        }
        else
        {
            Alerts.RemoveAll(a => a.Title.Contains("Gravity") || a.Title.Contains("Microgravity", StringComparison.OrdinalIgnoreCase));
            AppendAlert("Gravity profile restored", "Gravity simulation returned to the nominal environment profile.", "green", "PROFILE RESTORED");
            await ControlAudio(false);
        }
        StateHasChanged();
    }

    private void ToggleLatencySimulation()
    {
        LatencyShiftActive = !LatencyShiftActive;
        if (LatencyShiftActive)
        {
            AppendAlert("High latency simulated", "One-way delay exceeds 20-minute autonomy threshold.", "amber", "REVIEW EDGE ADVISOR");
        }
        else
        {
            Alerts.RemoveAll(a => a.Title.Contains("latency") || a.Title.Contains("delay", StringComparison.OrdinalIgnoreCase));
            AppendAlert("Earth link restored to nominal delay", "One-way delay is below the 20-minute autonomy threshold.", "green", "EARTH LINK AVAILABLE");
        }
    }

    private string GetAlertBadgeStyle()
    {
        if (CriticalCount > 0)
            return "bg-rose-400/15 text-rose-300 border border-rose-400/30 shadow-[0_0_10px_rgba(251,113,133,.25)] animate-pulse";
        if (CautionCount > 0)
            return "bg-amber-400/15 text-amber-300 border border-amber-400/30";
        return "bg-emerald-400/15 text-emerald-300 border border-emerald-400/30";
    }

    private async Task SaveHealthLog()
    {
        CurrentEntry.Timestamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") + "Z";
        Logs.Insert(0, CurrentEntry);
        CurrentEntry = new HealthLogEntry();
        SavedNotice = true;
        StateHasChanged();

        await Task.Delay(3500);
        SavedNotice = false;
        StateHasChanged();
    }

    private async Task ExportLogsJson()
    {
        var payload = new
        {
            schema = "astropulse.mission-health-log.v1",
            exportedAt = DateTime.UtcNow.ToString("o"),
            mission = "ARTEMIS DEEP SPACE SIM",
            environment = SelectedEnvironment,
            healthEntries = Logs,
            alerts = Alerts
        };
        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        var fileName = $"astropulse-health-log-{DateTime.UtcNow:yyyy-MM-dd}.json";

        await JS.InvokeVoidAsync("eval", $@"
            const blob = new Blob([{JsonSerializer.Serialize(json)}], {{ type: 'application/json' }});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = '{fileName}';
            a.click();
            URL.revokeObjectURL(url);
        ");
    }

    // --- HIGH-PRECISION DYNAMIC SPARKLINE RENDER HELPER MATCHING SCREENSHOT ---
    private RenderFragment RenderChartCard(string label, string unit, string color, double min, double max, Func<TelemetrySample, double> selector, string format, string dotTone) => __builder =>
    {
        var latest = Samples.LastOrDefault() is { } last ? selector(last) : 0;
        var points = string.Join(" ", Samples.Select((s, i) =>
        {
            var pct = Math.Clamp((selector(s) - min) / (max - min), 0.0, 1.0) * 100.0;
            var x = (i / Math.Max(Samples.Count - 1.0, 1.0)) * 100.0;
            var y = 38.0 - (pct / 100.0) * 34.0;
            return $"{x:F1},{y:F1}";
        }));

        <div class="rounded-xl border border-white/[.07] bg-[#080d14] p-4 relative">
            <div class="flex items-center justify-between">
                <p class="text-[9px] tracking-[.1em] text-slate-500">@label</p>
                <span class="size-2 rounded-full @GetToneFill(dotTone) @(dotTone == "red" ? "animate-pulse shadow-[0_0_8px_#fb7185]" : "")"></span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="font-mono text-2xl text-white">@latest.ToString(format)</span>
                <span class="text-[9px] text-slate-600">@unit</span>
            </div>
            <svg viewBox="0 0 100 40" preserveAspectRatio="none" class="mt-3 h-16 w-full">
                <polyline points="@points" fill="none" stroke="@color" stroke-width="1.8" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="mt-2 flex justify-between text-[8px] text-slate-700">
                <span>−300 SEC</span>
                <span>LIVE</span>
            </div>
        </div>
    };

    private string GetToneBorder(string tone) => tone switch { "red" => "border-rose-400/25", "amber" => "border-amber-400/20", _ => "border-emerald-400/20" };
    private string GetToneFill(string tone) => tone switch { "red" => "bg-rose-400", "amber" => "bg-amber-400", "cyan" => "bg-cyan-400", _ => "bg-emerald-400" };
    private string GetToneBadge(string tone) => tone switch { "red" => "bg-rose-400/10 text-rose-300", "amber" => "bg-amber-400/10 text-amber-300", _ => "bg-emerald-400/10 text-emerald-300" };
    private string GetToneGlow(string tone) => tone switch { "red" => "shadow-[0_0_10px_#fb7185]", "amber" => "shadow-[0_0_10px_#fbbf24]", _ => "shadow-[0_0_10px_#34d399]" };

    private record MissionAlert(string Tone, string Time, string Title, string Body, string Action);

    private class TelemetrySample
    {
        public double Pressure { get; set; }
        public double Temperature { get; set; }
        public double Acoustics { get; set; }
        public double Radiation { get; set; }
    }

    private class HealthLogEntry
    {
        public string Timestamp { get; set; } = "";
        public string BloodPressure { get; set; } = "";
        public string HeartRate { get; set; } = "";
        public string BloodSugar { get; set; } = "";
        public string Temperature { get; set; } = "";
        public string Sleep { get; set; } = "";
        public string Actigraphy { get; set; } = "";
        public string Mood { get; set; } = "";
        public string Notes { get; set; } = "";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _secondTimer?.Dispose();
        _cts.Dispose();
    }
}
