@page "/"
@rendermode InteractiveServer
@using AstroPulse.Models
@using System.Text.Json
@implements IDisposable
@inject IJSRuntime JS

<main class="min-h-screen bg-[#070b11] text-slate-300 selection:bg-cyan-400/20 font-mono">
    <header class="sticky top-0 z-20 border-b border-white/[.07] bg-[#080d14]/95 backdrop-blur-xl">
        <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-5 py-4 lg:px-8">
            <div class="flex items-center gap-3">
                <div class="relative flex size-10 items-center justify-center rounded-xl border border-cyan-400/20 bg-cyan-400/[.06] text-cyan-300">
                    <svg class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /><path d="M2 12h20" /></svg>
                    <span class="absolute -right-0.5 -top-0.5 size-2 rounded-full bg-emerald-400 shadow-[0_0_9px_#34d399]"></span>
                </div>
                <div>
                    <div class="flex items-baseline gap-2">
                        <h1 class="font-mono text-lg font-semibold tracking-[.14em] text-white">ASTROPULSE</h1>
                        <span class="hidden text-[9px] tracking-[.14em] text-slate-600 sm:block">HUMAN SPACEFLIGHT MONITOR</span>
                    </div>
                    <p class="text-[9px] tracking-[.14em] text-slate-500">MISSION CONTROL <span class="text-slate-700">/</span> ARTEMIS DEEP SPACE SIM</p>
                </div>
            </div>
            <div class="flex items-center gap-5">
                <div class="hidden items-center gap-2 rounded-md border border-emerald-400/20 bg-emerald-400/[.05] px-3 py-2 sm:flex">
                    <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-50"></span><span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span></span>
                    <span class="text-[9px] tracking-[.14em] text-emerald-300">TELEMETRY LIVE</span>
                </div>
                <div class="flex items-center gap-2 font-mono text-xs text-slate-300">
                    <svg class="size-[13px] text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <time>@_snapshot.TimestampUtc.ToString("HH:mm:ss") <span class="text-slate-600">UTC</span></time>
                </div>
            </div>
        </div>
    </header>

    <div class="mx-auto grid max-w-[1600px] gap-6 px-5 py-7 lg:grid-cols-[minmax(0,1fr)_330px] lg:px-8">
        <section class="min-w-0">
            <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
                <div>
                    <div class="mb-2 flex items-center gap-2 text-[9px] tracking-[.2em] text-cyan-400"><span class="h-px w-5 bg-cyan-400"></span>FLIGHT DECK <span class="text-slate-700">—</span> FLIGHT DAY 184</div>
                    <h2 class="text-2xl font-medium tracking-tight text-white sm:text-3xl">Crew health &amp; mission risk</h2>
                    <p class="mt-1.5 text-xs text-slate-500">Five hazards. One crew. Continuous awareness.</p>
                </div>
                <div class="flex items-center gap-2 rounded-lg border border-white/[.07] bg-white/[.02] px-3 py-2 text-[9px] tracking-[.12em] text-slate-500">
                    <svg class="size-[13px] text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 20h20M5 16l3-3 4 4 4-6 3 3" /></svg>ISS LINK <span class="text-emerald-300">CONNECTED</span>
                </div>
            </div>

            <!-- Simulation Control Deck -->
            <section class="mb-6 rounded-xl border border-cyan-400/15 bg-gradient-to-r from-cyan-950/20 via-[#0b121b] to-[#0b121b] p-4 sm:p-5">
                <div class="mb-4 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <svg class="size-[14px] text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" /></svg>
                        <h3 class="text-[10px] font-semibold tracking-[.17em] text-slate-200">SIMULATION CONTROL DECK</h3>
                    </div>
                    <span class="text-[9px] tracking-[.12em] text-slate-600">SANDBOX MODE <span class="text-cyan-400">●</span></span>
                </div>
                <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                    <button @onclick="TriggerSpe" class="flex min-h-11 items-center justify-center gap-2 rounded-lg border px-3 py-2 text-[10px] tracking-wide transition-colors @(_snapshot.SpaceRadiation.SolarParticleEventActive ? "border-red-400/30 bg-red-400/10 text-red-200" : "border-white/[.08] bg-[#080d14] text-slate-300 hover:border-red-400/30 hover:text-red-200")">
                        <svg class="size-[14px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                        @(_snapshot.SpaceRadiation.SolarParticleEventActive ? "Solar Event Active · Reset" : "Trigger Solar Particle Event")
                    </button>
                    <button @onclick="CycleGravity" class="flex min-h-11 items-center justify-center gap-2 rounded-lg border border-white/[.08] bg-[#080d14] px-3 py-2 text-[10px] tracking-wide text-slate-300 transition-colors hover:border-cyan-400/30 hover:text-cyan-200">
                        <svg class="size-[14px] text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                        Cycle Gravity Mode <span class="text-cyan-300">@_snapshot.GravityFields.CurrentGravityMode</span>
                    </button>
                    <button @onclick="ToggleLight" class="flex min-h-11 items-center justify-center gap-2 rounded-lg border px-3 py-2 text-[10px] tracking-wide transition-colors @(_snapshot.IsolationConfinement.LightTherapyActive ? "border-amber-400/30 bg-amber-400/10 text-amber-200" : "border-white/[.08] bg-[#080d14] text-slate-300 hover:border-amber-400/30 hover:text-amber-200")">
                        <svg class="size-[14px] @(_snapshot.IsolationConfinement.LightTherapyActive ? "text-amber-300" : "text-slate-500")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
                        @(_snapshot.IsolationConfinement.LightTherapyActive ? "Light Therapy · Active" : "Toggle Light Therapy")
                    </button>
                    <button @onclick="ExportMissionLog" class="flex min-h-11 items-center justify-center gap-2 rounded-lg border border-emerald-400/20 bg-emerald-400/[.05] px-3 py-2 text-[10px] tracking-wide text-emerald-300 transition-colors hover:bg-emerald-400/10">
                        <svg class="size-[14px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Export Mission Log
                    </button>
                </div>
            </section>

            <div class="mb-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <svg class="size-[14px] text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                    <h3 class="text-[10px] font-semibold tracking-[.17em] text-slate-300">HUMAN SPACEFLIGHT HAZARDS</h3>
                </div>
                <span class="font-mono text-[9px] text-slate-600">05 SYSTEMS TRACKED</span>
            </div>

            <!-- 5 Hazards Grid Cards -->
            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                
                <!-- 1. Hostile Closed Environments -->
                <article class="group relative overflow-hidden rounded-xl border border-emerald-400/20 bg-[#0b121b]/90 p-5">
                    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="flex size-9 items-center justify-center rounded-lg border border-emerald-400/20 bg-white/[.025] text-emerald-300">
                                <svg class="size-[17px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2" /></svg>
                            </div>
                            <div>
                                <p class="text-[10px] font-semibold tracking-[.16em] text-slate-100">HOSTILE ENVIRONMENTS</p>
                                <p class="mt-1 text-[9px] tracking-[.12em] text-slate-600">CABIN SYSTEMS</p>
                            </div>
                        </div>
                        <span class="flex items-center gap-1.5 rounded-full px-2 py-1 text-[8px] tracking-[.12em] bg-emerald-400/10 text-emerald-300">
                            <span class="size-1.5 rounded-full bg-emerald-400"></span>NOMINAL
                        </span>
                    </div>
                    <div class="mt-6 flex items-end gap-2">
                        <span class="font-mono text-[34px] leading-none tracking-tight text-slate-50">@_snapshot.HostileEnvironment.CabinTempC.ToString("F1")</span>
                        <span class="pb-0.5 font-mono text-xs text-emerald-300">°C</span>
                    </div>
                    <p class="mt-2 text-[10px] text-slate-500">Cabin Pressure: @_snapshot.HostileEnvironment.CabinPressureKpa kPa · Noise: @_snapshot.HostileEnvironment.NoiseDb dBA</p>
                    <div class="mt-4 flex items-center justify-between border-t border-white/[.06] pt-3">
                        <span class="text-[9px] tracking-[.12em] text-slate-600">MICROBIAL STRESS INDEX</span>
                        <span class="font-mono text-[11px] text-emerald-300">@_snapshot.HostileEnvironment.MicrobialImmuneIndex / 100</span>
                    </div>
                    <div class="mt-4 flex items-center justify-between text-[9px] text-slate-600">
                        <span>ECLSS Loop Active</span><span class="text-slate-700">LIVE</span>
                    </div>
                </article>

                <!-- 2. Gravity Fields -->
                <article class="group relative overflow-hidden rounded-xl border border-amber-400/20 bg-[#0b121b]/90 p-5">
                    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="flex size-9 items-center justify-center rounded-lg border border-amber-400/20 bg-white/[.025] text-amber-300">
                                <svg class="size-[17px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="4" /></svg>
                            </div>
                            <div>
                                <p class="text-[10px] font-semibold tracking-[.16em] text-slate-100">GRAVITY FIELDS</p>
                                <p class="mt-1 text-[9px] tracking-[.12em] text-slate-600">@_snapshot.GravityFields.CurrentGravityMode</p>
                            </div>
                        </div>
                        <span class="flex items-center gap-1.5 rounded-full px-2 py-1 text-[8px] tracking-[.12em] bg-amber-400/10 text-amber-300">
                            <span class="size-1.5 rounded-full bg-amber-400"></span>MONITOR
                        </span>
                    </div>
                    <div class="mt-6 flex items-end gap-2">
                        <span class="font-mono text-[34px] leading-none tracking-tight text-slate-50">@_snapshot.GravityFields.HeartRateBpm</span>
                        <span class="pb-0.5 font-mono text-xs text-amber-300">bpm</span>
                    </div>
                    <p class="mt-2 text-[10px] text-slate-500">Hydration: @_snapshot.GravityFields.HydrationPercent% · ARED Protocol</p>
                    <div class="mt-4 flex items-center justify-between border-t border-white/[.06] pt-3">
                        <span class="text-[9px] tracking-[.12em] text-slate-600">BONE LOSS RATE</span>
                        <span class="font-mono text-[11px] text-amber-300">−@_snapshot.GravityFields.MonthlyBoneLossRate% / mo</span>
                    </div>
                    <div class="mt-4 flex items-center justify-between text-[9px] text-slate-600">
                        <span>Resistive exercise active</span><span class="text-slate-700">LIVE</span>
                    </div>
                </article>

                <!-- 3. Distance From Earth -->
                <article class="group relative overflow-hidden rounded-xl border border-emerald-400/20 bg-[#0b121b]/90 p-5">
                    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="flex size-9 items-center justify-center rounded-lg border border-emerald-400/20 bg-white/[.025] text-emerald-300">
                                <svg class="size-[17px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="22" y1="12" x2="18" y2="12" /><line x1="6" y1="12" x2="2" y2="12" /><line x1="12" y1="6" x2="12" y2="2" /><line x1="12" y1="22" x2="12" y2="18" /></svg>
                            </div>
                            <div>
                                <p class="text-[10px] font-semibold tracking-[.16em] text-slate-100">DISTANCE FROM EARTH</p>
                                <p class="mt-1 text-[9px] tracking-[.12em] text-slate-600">DEEP SPACE</p>
                            </div>
                        </div>
                        <span class="flex items-center gap-1.5 rounded-full px-2 py-1 text-[8px] tracking-[.12em] bg-emerald-400/10 text-emerald-300">
                            <span class="size-1.5 rounded-full bg-emerald-400"></span>NOMINAL
                        </span>
                    </div>
                    <div class="mt-6 flex items-end gap-2">
                        <span class="font-mono text-[34px] leading-none tracking-tight text-slate-50">@_snapshot.DistanceFromEarth.DistanceMillionMiles.ToString("F1")</span>
                        <span class="pb-0.5 font-mono text-xs text-emerald-300">M miles</span>
                    </div>
                    <p class="mt-2 text-[10px] text-slate-500">Autonomous Edge Routing Active</p>
                    <div class="mt-4 flex items-center justify-between border-t border-white/[.06] pt-3">
                        <span class="text-[9px] tracking-[.12em] text-slate-600">ONE-WAY COMMS DELAY</span>
                        <span class="font-mono text-[11px] text-emerald-300">@_snapshot.DistanceFromEarth.OneWayCommsDelayMinutes.ToString("F1") min</span>
                    </div>
                    <div class="mt-4 flex items-center justify-between text-[9px] text-slate-600">
                        <span>Signal strength −68 dBm</span><span class="text-slate-700">LIVE</span>
                    </div>
                </article>

                <!-- 4. Isolation & Confinement -->
                <article class="group relative overflow-hidden rounded-xl border border-amber-400/20 bg-[#0b121b]/90 p-5">
                    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="flex size-9 items-center justify-center rounded-lg border border-amber-400/20 bg-white/[.025] text-amber-300">
                                <svg class="size-[17px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="3" /></svg>
                            </div>
                            <div>
                                <p class="text-[10px] font-semibold tracking-[.16em] text-slate-100">ISOLATION & CONFINEMENT</p>
                                <p class="mt-1 text-[9px] tracking-[.12em] text-slate-600">CREW WELLNESS</p>
                            </div>
                        </div>
                        <span class="flex items-center gap-1.5 rounded-full px-2 py-1 text-[8px] tracking-[.12em] bg-amber-400/10 text-amber-300">
                            <span class="size-1.5 rounded-full bg-amber-400"></span>ELEVATED
                        </span>
                    </div>
                    <div class="mt-6 flex items-end gap-2">
                        <span class="font-mono text-[34px] leading-none tracking-tight text-slate-50">@_snapshot.IsolationConfinement.CircadianAlignmentPercent.ToString("F0")</span>
                        <span class="pb-0.5 font-mono text-xs text-amber-300">%</span>
                    </div>
                    <p class="mt-2 text-[10px] text-slate-500">Circadian alignment index</p>
                    <div class="mt-4 flex items-center justify-between border-t border-white/[.06] pt-3">
                        <span class="text-[9px] tracking-[.12em] text-slate-600">WORKLOAD INDEX</span>
                        <span class="font-mono text-[11px] text-amber-300">@_snapshot.IsolationConfinement.WorkloadIndex / 100</span>
                    </div>
                    <div class="mt-4 flex items-center justify-between text-[9px] text-slate-600">
                        <span>Light therapy: @(_snapshot.IsolationConfinement.LightTherapyActive ? "ON" : "OFF")</span><span class="text-slate-700">LIVE</span>
                    </div>
                </article>

                <!-- 5. Space Radiation -->
                <article class="group relative overflow-hidden rounded-xl border @(_snapshot.SpaceRadiation.SolarParticleEventActive ? "border-red-400/50 bg-red-950/20" : "border-red-400/25") bg-[#0b121b]/90 p-5 md:col-span-2 xl:col-span-1">
                    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="flex size-9 items-center justify-center rounded-lg border border-red-400/25 bg-white/[.025] text-red-300">
                                <svg class="size-[17px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                            </div>
                            <div>
                                <p class="text-[10px] font-semibold tracking-[.16em] text-slate-100">SPACE RADIATION</p>
                                <p class="mt-1 text-[9px] tracking-[.12em] text-slate-600">CSA NEUTRON SPECTROMETER</p>
                            </div>
                        </div>
                        <span class="flex items-center gap-1.5 rounded-full px-2 py-1 text-[8px] tracking-[.12em] bg-red-400/10 text-red-300">
                            <span class="size-1.5 rounded-full bg-red-400 animate-pulse"></span>@(_snapshot.SpaceRadiation.SolarParticleEventActive ? "SPE ACTIVE" : "NOMINAL")
                        </span>
                    </div>
                    <div class="mt-6 flex items-end gap-2">
                        <span class="font-mono text-[34px] leading-none tracking-tight text-slate-50">@_snapshot.SpaceRadiation.RadiationMicroSvPerHour.ToString("F1")</span>
                        <span class="pb-0.5 font-mono text-xs text-red-300">µSv/h</span>
                    </div>
                    <p class="mt-2 text-[10px] text-slate-500">Neutron flux monitoring active</p>
                    <div class="mt-4 flex items-center justify-between border-t border-white/[.06] pt-3">
                        <span class="text-[9px] tracking-[.12em] text-slate-600">CUMULATIVE DOSE</span>
                        <span class="font-mono text-[11px] text-red-300">@_snapshot.SpaceRadiation.CumulativeDoseMilliSv.ToString("F1") mSv</span>
                    </div>
                    <div class="mt-4 flex items-center justify-between text-[9px] text-slate-600">
                        <span>Career limit 600 mSv</span><span class="text-slate-700">LIVE</span>
                    </div>
                </article>

            </div>

            <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-white/[.06] pt-4 text-[9px] tracking-[.08em] text-slate-600">
                <span class="flex items-center gap-2">DATA SIMULATION — NASA-STD-3001 &amp; HRP COMPLIANT</span>
                <span>FEED LATENCY &lt; 250ms <span class="text-emerald-400">●</span></span>
            </div>
        </section>

        <!-- Right Sidebar: Alerts & Countermeasures Feed -->
        <aside class="flex flex-col gap-4">
            <section class="rounded-xl border border-white/[.08] bg-[#0b121b] p-4">
                <div class="mb-4 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="flex size-7 items-center justify-center rounded-lg border border-red-400/20 bg-red-400/[.07] text-red-300">
                            <svg class="size-[14px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                        </div>
                        <div>
                            <h2 class="text-[10px] font-semibold tracking-[.14em] text-slate-100">ALERT FEED</h2>
                            <p class="mt-0.5 text-[9px] text-slate-600">REAL-TIME MISSION EVENTS</p>
                        </div>
                    </div>
                    <span class="rounded-full border border-red-400/20 bg-red-400/[.07] px-2 py-1 font-mono text-[9px] text-red-300">@_snapshot.ActiveAlerts.Count.ToString("D2") ACTIVE</span>
                </div>

                <div class="flex flex-col gap-3 max-h-[500px] overflow-y-auto pr-1">
                    @if (_snapshot.ActiveAlerts.Any())
                    {
                        @foreach (var alert in _snapshot.ActiveAlerts)
                        {
                            <article class="rounded-lg border p-3 @GetAlertCardClass(alert.Severity)">
                                <div class="mb-2 flex items-center justify-between">
                                    <span class="flex items-center gap-2 text-[9px] tracking-[.12em] text-slate-300">
                                        <span class="size-2 shrink-0 rounded-full @GetSeverityDotClass(alert.Severity)"></span>
                                        @alert.Severity
                                    </span>
                                    <time class="font-mono text-[9px] text-slate-600">@alert.TriggeredAtUtc.ToString("HH:mm:ss")Z</time>
                                </div>
                                <h3 class="text-[11px] font-medium text-slate-200">@alert.NasaHrpRiskTitle</h3>
                                <p class="mt-1.5 text-[10px] leading-relaxed text-slate-400">@alert.Description</p>
                                <div class="mt-3 flex items-center gap-1.5 rounded-md px-2 py-1.5 text-[8px] tracking-[.08em] bg-black/30 border border-white/10 text-cyan-300">
                                    <svg class="size-[11px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                                    @alert.RecommendedCountermeasure
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="text-center text-slate-500 py-10 text-xs">
                            <p>All telemetry parameters nominal.</p>
                            <p class="text-[10px] mt-1">No active HRP hazard alerts triggered.</p>
                        </div>
                    }
                </div>
            </section>

